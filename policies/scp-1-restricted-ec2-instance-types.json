{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDisallowedEC2InstanceTypes",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotEquals": {
          "ec2:InstanceType": ["t2.micro", "t3.micro", "t3.small"]
        }
      }
    }
  ]
}
